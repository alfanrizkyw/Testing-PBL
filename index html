<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Samudra Land — Pesan Tiket Wahana</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --blue-deep:#0B3B5C;
  --blue-primary:#155E92;
  --blue-mid:#2C82B8;
  --blue-sky:#6BB6E0;
  --blue-pale:#EEF6FB;
  --blue-pale-2:#F7FBFD;
  --white:#FFFFFF;
  --ink:#12293B;
  --ink-soft:#5C7488;
  --accent:#E8A33D;
  --danger:#C4432E;
  --line:#DCEAF3;
  --shadow:0 16px 34px -20px rgba(11,59,92,0.32);
  --radius-lg:22px;
  --radius-md:16px;
  --radius-sm:10px;
  --nav-h:60px;
}
*{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  margin:0;
  font-family:'Plus Jakarta Sans', sans-serif;
  color:var(--ink);
  background:var(--blue-pale-2);
  -webkit-font-smoothing:antialiased;
}
h1,h2,h3,.display{
  font-family:'Fraunces', serif;
  font-weight:600;
  letter-spacing:-0.01em;
  margin:0;
  color:var(--blue-deep);
}
p{line-height:1.6;color:var(--ink-soft);margin:0;font-size:14.5px;}
img,svg{display:block;}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit;}
a{color:inherit;text-decoration:none;}
input{font-family:inherit;}
.container{max-width:1120px;margin:0 auto;padding:0 20px;}
.ic{flex-shrink:0;}

/* ================= NAV ================= */
#navbar{
  position:sticky;top:0;z-index:40;height:var(--nav-h);
  background:rgba(255,255,255,0.94);
  backdrop-filter:blur(10px);
  border-bottom:1px solid var(--line);
}
.nav-inner{
  max-width:1120px;margin:0 auto;padding:0 20px;height:var(--nav-h);
  display:flex;align-items:center;justify-content:space-between;
}
.brand{display:flex;align-items:center;gap:9px;}
.brand-mark{
  width:32px;height:32px;border-radius:9px;
  background:var(--blue-deep);
  display:flex;align-items:center;justify-content:center;color:#fff;
}
.brand-name{font-family:'Fraunces',serif;font-weight:700;font-size:17px;color:var(--blue-deep);}
.nav-links{display:flex;align-items:center;gap:6px;}
.nav-link{
  padding:8px 14px;border-radius:8px;font-weight:600;font-size:13.5px;
  color:var(--ink-soft);transition:background .15s,color .15s;
}
.nav-link.active,.nav-link:hover{background:var(--blue-pale);color:var(--blue-deep);}
.nav-cart{
  position:relative;display:flex;align-items:center;gap:7px;
  padding:8px 14px;border-radius:8px;background:var(--blue-deep);color:#fff;font-weight:600;font-size:13.5px;
  transition:background .15s;
}
.nav-cart:hover{background:var(--blue-primary);}
.cart-badge{
  position:absolute;top:-5px;right:-5px;background:var(--accent);color:var(--blue-deep);
  font-size:10.5px;font-weight:700;border-radius:999px;min-width:17px;height:17px;
  display:flex;align-items:center;justify-content:center;padding:0 4px;
}
.cart-badge.hidden{display:none;}

/* ================= PAGES: each one full viewport ================= */
.page{
  display:none;
  min-height:calc(100vh - var(--nav-h));
  animation:fadeSlide .3s ease;
}
.page.active{display:block;}
@keyframes fadeSlide{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}
.page-pad{padding:28px 0 60px;}

/* ================= HOME ================= */
.home-top{padding:22px 0 8px;}
.search-bar{
  display:flex;align-items:center;gap:10px;background:#fff;border:1.5px solid var(--line);
  border-radius:12px;padding:12px 16px;box-shadow:var(--shadow);color:var(--ink-soft);
}
.search-bar input{border:none;outline:none;flex:1;font-size:14.5px;background:transparent;color:var(--ink);}
.search-bar button{color:var(--blue-primary);}

.quick-menu{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:22px 0 6px;}
.quick-item{
  background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px 8px;
  display:flex;flex-direction:column;align-items:center;gap:9px;transition:border-color .15s,transform .15s;
}
.quick-item:hover{border-color:var(--blue-sky);transform:translateY(-2px);}
.quick-item .qi-icon{width:42px;height:42px;border-radius:11px;background:var(--blue-pale);color:var(--blue-primary);display:flex;align-items:center;justify-content:center;}
.quick-item span{font-size:12px;font-weight:700;color:var(--ink);text-align:center;}

.section-label{display:flex;align-items:center;justify-content:space-between;margin:30px 0 14px;}
.section-label h2{font-size:19px;}
.section-label a{font-size:13px;font-weight:700;color:var(--blue-primary);}

/* Gojek-style banner card: photo + overlay + bold text */
.promo-banner{
  position:relative;border-radius:var(--radius-lg);overflow:hidden;min-height:200px;
  background-size:cover;background-position:center;display:flex;align-items:flex-end;
  box-shadow:var(--shadow);margin-bottom:16px;
}
.promo-banner::before{
  content:"";position:absolute;inset:0;
  background:linear-gradient(180deg, rgba(11,59,92,0) 30%, rgba(11,59,92,.92) 100%);
}
.promo-banner-body{position:relative;padding:20px 22px;color:#fff;width:100%;}
.promo-banner-body .tag{display:inline-block;background:var(--accent);color:var(--blue-deep);font-size:11px;font-weight:800;padding:4px 10px;border-radius:6px;margin-bottom:10px;text-transform:uppercase;letter-spacing:.03em;}
.promo-banner-body h3{color:#fff;font-size:22px;margin-bottom:6px;}
.promo-banner-body p{color:rgba(255,255,255,.85);font-size:13.5px;max-width:440px;}
.promo-banner-body .btn{margin-top:14px;}

/* ================= WAHANA CARDS (image background, gojek style) ================= */
.filters{display:flex;gap:8px;margin-bottom:22px;flex-wrap:wrap;}
.chip{padding:8px 16px;border-radius:8px;border:1.5px solid var(--line);font-size:13px;font-weight:600;color:var(--ink-soft);background:#fff;transition:all .15s;}
.chip.active,.chip:hover{background:var(--blue-deep);color:#fff;border-color:var(--blue-deep);}

.wahana-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;}
.wahana-card{
  background:var(--white);border:1px solid var(--line);border-radius:var(--radius-md);
  overflow:hidden;transition:border-color .2s,box-shadow .2s,transform .2s;display:flex;flex-direction:column;
}
.wahana-card:hover{border-color:var(--blue-sky);box-shadow:var(--shadow);transform:translateY(-3px);}
.wahana-media{
  position:relative;height:150px;background-size:cover;background-position:center;
}
.wahana-media::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg, rgba(11,59,92,0) 45%, rgba(11,59,92,.78) 100%);}
.wahana-media-tag{position:relative;margin:12px;display:inline-block;background:rgba(255,255,255,.92);color:var(--blue-primary);font-size:10.5px;font-weight:800;padding:5px 10px;border-radius:6px;text-transform:uppercase;letter-spacing:.03em;}
.wahana-media-title{position:relative;padding:0 14px 12px;color:#fff;font-family:'Fraunces',serif;font-size:16.5px;font-weight:700;}
.wahana-body{padding:14px 16px 16px;display:flex;flex-direction:column;gap:9px;flex:1;}
.wahana-meta{display:flex;gap:14px;font-size:12px;color:var(--ink-soft);}
.wahana-meta span{display:flex;align-items:center;gap:5px;}
.wahana-foot{display:flex;align-items:center;justify-content:space-between;margin-top:4px;padding-top:12px;border-top:1px solid var(--line);}
.price{font-family:'Fraunces',serif;font-weight:700;font-size:16.5px;color:var(--blue-deep);}
.price small{font-family:'Plus Jakarta Sans',sans-serif;font-weight:500;font-size:10.5px;color:var(--ink-soft);display:block;}

/* ================= BUTTONS ================= */
.btn{
  padding:12px 22px;border-radius:9px;font-weight:700;font-size:13.5px;
  display:inline-flex;align-items:center;justify-content:center;gap:8px;transition:background .15s,border-color .15s,opacity .15s;
  white-space:nowrap;
}
.btn-primary{background:var(--blue-deep);color:#fff;}
.btn-primary:hover{background:var(--blue-primary);}
.btn-ghost{background:var(--white);color:var(--blue-deep);border:1.5px solid var(--line);}
.btn-ghost:hover{border-color:var(--blue-sky);}
.btn-ghost.on-dark{background:rgba(255,255,255,.14);color:#fff;border-color:rgba(255,255,255,.3);}
.btn-block{width:100%;}
.btn-accent{background:var(--accent);color:var(--blue-deep);}
.btn-accent:hover{opacity:.88;}
.btn-sm{padding:9px 16px;font-size:12.5px;}
.btn[disabled]{opacity:.5;pointer-events:none;}

/* ================= WAHANA DETAIL ================= */
.detail-back{display:inline-flex;align-items:center;gap:7px;font-size:13.5px;font-weight:700;color:var(--blue-primary);margin-bottom:18px;}
.detail-layout{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:flex-start;}
.detail-media{
  border-radius:var(--radius-lg);overflow:hidden;height:380px;background-size:cover;background-position:center;
  position:relative;box-shadow:var(--shadow);
}
.detail-media::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg, rgba(11,59,92,0) 55%, rgba(11,59,92,.85) 100%);}
.detail-media-tag{position:absolute;top:18px;left:18px;background:rgba(255,255,255,.92);color:var(--blue-primary);font-size:11px;font-weight:800;padding:6px 12px;border-radius:7px;text-transform:uppercase;letter-spacing:.03em;}
.detail-media-title{position:absolute;bottom:20px;left:22px;right:22px;color:#fff;font-size:26px;}
.detail-info h1{font-size:26px;margin-bottom:14px;}
.detail-meta-row{display:flex;gap:22px;margin-bottom:18px;flex-wrap:wrap;}
.detail-meta-item{display:flex;align-items:center;gap:8px;font-size:13.5px;color:var(--ink-soft);}
.detail-meta-item b{color:var(--ink);}
.detail-desc{margin-bottom:22px;}
.detail-price-box{
  background:#fff;border:1px solid var(--line);border-radius:var(--radius-md);padding:22px;
}
.detail-price-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;}
.detail-price-row .price{font-size:24px;}
.stepper{display:flex;align-items:center;border:1.5px solid var(--line);border-radius:10px;overflow:hidden;}
.stepper button{width:40px;height:40px;font-size:18px;font-weight:700;color:var(--blue-primary);transition:background .15s;}
.stepper button:hover{background:var(--blue-pale);}
.stepper span{width:44px;text-align:center;font-weight:700;font-size:15px;}
.detail-subtotal{display:flex;justify-content:space-between;font-size:14px;color:var(--ink-soft);margin-bottom:16px;padding-top:14px;border-top:1px solid var(--line);}
.detail-subtotal b{color:var(--blue-deep);font-family:'Fraunces',serif;font-size:17px;}

/* ================= CART BAR ================= */
#cartBar{
  position:fixed;left:0;right:0;bottom:-120px;z-index:50;
  background:var(--blue-deep);color:#fff;padding:14px 0;
  transition:bottom .3s ease;
}
#cartBar.show{bottom:0;}
.cartbar-inner{max-width:1120px;margin:0 auto;padding:0 20px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;}
.cartbar-info b{font-family:'Fraunces',serif;font-size:17px;}
.cartbar-info span{font-size:12px;opacity:.72;display:block;}

/* ================= PAYMENT ================= */
.pay-layout{display:grid;grid-template-columns:1fr .85fr;gap:24px;align-items:flex-start;}
.card-panel{background:var(--white);border:1px solid var(--line);border-radius:var(--radius-md);padding:24px;}
.card-panel h3{font-size:16px;margin-bottom:14px;}
.cart-item-row{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);}
.cart-item-media{width:52px;height:52px;border-radius:9px;background-size:cover;background-position:center;flex-shrink:0;}
.cart-item-info{flex:1;}
.cart-item-info b{display:block;font-size:14px;color:var(--ink);}
.cart-item-info span{font-size:12px;color:var(--ink-soft);}
.cart-item-right{display:flex;align-items:center;gap:10px;}
.cart-item-remove{color:var(--danger);}
.field{display:flex;flex-direction:column;gap:6px;margin-bottom:14px;}
.field label{font-size:12.5px;font-weight:700;color:var(--blue-deep);}
.field input{
  padding:11px 13px;border-radius:8px;border:1.5px solid var(--line);font-size:14px;width:100%;
  font-family:inherit;transition:border-color .15s;background:var(--blue-pale-2);
}
.field input:focus{outline:none;border-color:var(--blue-sky);background:#fff;}
.pay-methods{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:4px;}
.pay-method{
  border:1.5px solid var(--line);border-radius:8px;padding:13px;display:flex;align-items:center;gap:10px;
  transition:border-color .15s,background .15s;font-weight:600;font-size:13.5px;color:var(--ink-soft);
}
.pay-method.selected{border-color:var(--blue-primary);background:var(--blue-pale);color:var(--blue-deep);}

.nota{background:var(--blue-pale-2);border:1px solid var(--line);border-radius:var(--radius-md);padding:22px;}
.nota-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px;padding-bottom:14px;border-bottom:1px solid var(--line);}
.nota-head h4{font-family:'Fraunces',serif;font-size:16px;color:var(--blue-deep);}
.nota-head span{font-size:11.5px;color:var(--ink-soft);}
.nota-row{display:flex;justify-content:space-between;font-size:13.5px;padding:6px 0;color:var(--ink);}
.nota-row.sub{color:var(--ink-soft);font-size:12.5px;}
.nota-total{display:flex;justify-content:space-between;padding-top:13px;margin-top:6px;border-top:1.5px solid var(--blue-deep);font-family:'Fraunces',serif;font-weight:700;font-size:18px;color:var(--blue-deep);}
.empty-note{text-align:center;padding:60px 20px;color:var(--ink-soft);}
.empty-note .qi-icon{width:52px;height:52px;border-radius:14px;background:var(--blue-pale);color:var(--blue-primary);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;}

/* ================= TICKET ================= */
.tabs{display:flex;gap:8px;margin-bottom:24px;}
.tab-btn{padding:9px 18px;border-radius:8px;font-weight:600;font-size:13.5px;color:var(--ink-soft);border:1.5px solid var(--line);background:#fff;}
.tab-btn.active{background:var(--blue-deep);color:#fff;border-color:var(--blue-deep);}
.ticket-card{
  background:var(--white);
  border:1px solid var(--line);border-radius:var(--radius-md);padding:0;margin-bottom:18px;overflow:hidden;
  display:grid;grid-template-columns:1fr 210px;
}
.ticket-main{padding:22px 24px;}
.ticket-eyebrow{font-size:10.5px;font-weight:700;color:var(--blue-mid);letter-spacing:.03em;text-transform:uppercase;}
.ticket-main h3{font-size:20px;margin:6px 0 4px;}
.ticket-sub{font-size:12.5px;color:var(--ink-soft);margin-bottom:16px;}
.ticket-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:14px;}
.ticket-grid div span{display:block;font-size:10.5px;color:var(--ink-soft);text-transform:uppercase;letter-spacing:.03em;margin-bottom:3px;}
.ticket-grid div b{font-size:13.5px;color:var(--ink);}
.ticket-code{font-family:'Fraunces',serif;font-weight:700;letter-spacing:.03em;color:var(--blue-deep);font-size:14px;word-break:break-all;}
.ticket-stub{
  background:var(--blue-deep);color:#fff;padding:18px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;
  border-left:1px dashed rgba(255,255,255,.3);
}
.qr-box{background:#fff;border-radius:8px;padding:8px;width:150px;height:150px;display:flex;align-items:center;justify-content:center;}
.qr-box img{width:100%;height:100%;object-fit:contain;}
.ticket-stub small{font-size:10px;letter-spacing:.03em;opacity:.8;text-align:center;}
@media print{
  #navbar,#chatWidget,.tabs,footer,#cartBar,.no-print{display:none!important;}
  body{background:#fff;}
  .page{display:none;min-height:0;}
  .page.active{display:block;}
  .ticket-card{box-shadow:none;break-inside:avoid;}
}

/* ================= ADMIN ================= */
#adminOverlay{position:fixed;inset:0;z-index:100;background:var(--blue-pale-2);overflow-y:auto;display:none;}
#adminOverlay.show{display:block;}
.admin-top{background:var(--blue-deep);color:#fff;padding:18px 0;}
.admin-top .container{display:flex;justify-content:space-between;align-items:center;}
.admin-top h2{color:#fff;font-size:19px;}
.admin-top span{font-size:12px;opacity:.7;}
.admin-body{padding:30px 0 56px;}
.stat-row{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:28px;}
.stat-box{background:#fff;border:1px solid var(--line);border-radius:var(--radius-md);padding:18px;}
.stat-box span{font-size:11.5px;color:var(--ink-soft);font-weight:600;}
.stat-box b{display:block;font-family:'Fraunces',serif;font-size:21px;color:var(--blue-deep);margin-top:6px;}
.admin-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:18px;align-items:flex-start;}
.bar-row{display:flex;align-items:center;gap:12px;margin-bottom:13px;}
.bar-row .lbl{width:150px;font-size:12.5px;font-weight:600;flex-shrink:0;}
.bar-track{flex:1;height:9px;background:var(--blue-pale);border-radius:999px;overflow:hidden;}
.bar-fill{height:100%;background:var(--blue-primary);border-radius:999px;transition:width .5s ease;}
.bar-row .val{width:60px;text-align:right;font-size:11.5px;color:var(--ink-soft);font-weight:700;flex-shrink:0;}
table{width:100%;border-collapse:collapse;font-size:12.5px;}
th{text-align:left;color:var(--ink-soft);font-weight:700;font-size:10.5px;text-transform:uppercase;letter-spacing:.03em;padding:9px 8px;border-bottom:1.5px solid var(--line);}
td{padding:10px 8px;border-bottom:1px solid var(--line);}

/* ================= MODAL (Info Taman) ================= */
#infoModalWrap{position:fixed;inset:0;z-index:90;display:none;align-items:center;justify-content:center;padding:20px;}
#infoModalWrap.show{display:flex;}
.modal-backdrop{position:absolute;inset:0;background:rgba(11,59,92,.5);}
.modal-box{position:relative;background:#fff;border-radius:var(--radius-lg);max-width:400px;width:100%;padding:26px;}
.modal-close{position:absolute;top:16px;right:16px;color:var(--ink-soft);}
.modal-box h3{font-size:19px;margin-bottom:16px;}
.modal-row{display:flex;gap:12px;padding:10px 0;border-bottom:1px solid var(--line);}
.modal-row:last-child{border-bottom:none;}
.modal-row .qi-icon{width:34px;height:34px;border-radius:9px;background:var(--blue-pale);color:var(--blue-primary);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.modal-row b{display:block;font-size:13.5px;color:var(--ink);}
.modal-row span{font-size:12.5px;color:var(--ink-soft);}

/* ================= CHAT ================= */
#chatWidget{position:fixed;bottom:22px;right:22px;z-index:60;}
#chatBubble{
  width:50px;height:50px;border-radius:12px;background:var(--blue-deep);color:#fff;
  display:flex;align-items:center;justify-content:center;transition:background .15s;
}
#chatBubble:hover{background:var(--blue-primary);}
#chatPanel{
  position:absolute;bottom:60px;right:0;width:320px;max-height:430px;background:#fff;border-radius:var(--radius-md);
  box-shadow:var(--shadow);border:1px solid var(--line);display:none;flex-direction:column;overflow:hidden;
}
#chatPanel.open{display:flex;animation:fadeSlide .2s ease;}
.chat-head{background:var(--blue-deep);color:#fff;padding:12px 14px;display:flex;align-items:center;gap:10px;}
.chat-head b{font-size:13.5px;font-family:'Fraunces',serif;}
.chat-head span{font-size:10px;opacity:.7;display:block;}
.chat-dot{width:7px;height:7px;border-radius:50%;background:#4CE0A1;flex-shrink:0;}
.chat-body{flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:9px;background:var(--blue-pale-2);}
.msg{max-width:82%;padding:9px 12px;border-radius:10px;font-size:12.5px;line-height:1.5;}
.msg.assistant{background:#fff;border:1px solid var(--line);align-self:flex-start;color:var(--ink);}
.msg.user{background:var(--blue-deep);color:#fff;align-self:flex-end;}
.chat-input-row{display:flex;border-top:1px solid var(--line);padding:9px;gap:8px;background:#fff;}
.chat-input-row input{flex:1;border:1.5px solid var(--line);border-radius:8px;padding:9px 12px;font-size:12.5px;font-family:inherit;}
.chat-input-row input:focus{outline:none;border-color:var(--blue-sky);}
.chat-send{width:34px;height:34px;border-radius:8px;background:var(--blue-deep);color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0;}

/* ================= FOOTER ================= */
footer{background:var(--blue-deep);color:rgba(255,255,255,.7);padding:32px 0 20px;}
footer .container{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;}
footer .fbrand{color:#fff;font-family:'Fraunces',serif;font-size:15px;font-weight:700;}
#secretTrigger{cursor:default;font-size:11.5px;user-select:none;}

.hidden{display:none!important;}

