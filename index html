/* ================= DATA ================= */
const WAHANA = [
  {id:'ombak-raksasa', nama:'Ombak Raksasa', kategori:'Ekstrem', harga:85000, durasi:'3 mnt', tinggi:'140 cm', ic:'coaster', seed:'coaster-ride', desc:'Roller coaster tercepat di Samudra Land, menukik tajam menghadap laut lepas. Wahana ini melewati tiga putaran penuh dengan kecepatan tinggi, cocok untuk pencari sensasi ekstrem.'},
  {id:'seluncur-naga', nama:'Seluncur Naga', kategori:'Air', harga:65000, durasi:'2 mnt', tinggi:'120 cm', ic:'wave', seed:'water-slide', desc:'Perosotan air sepanjang 80 meter dengan tikungan berliku menyerupai tubuh naga. Meluncur dari ketinggian menuju kolam penampungan yang segar.'},
  {id:'bianglala', nama:'Bianglala Cakrawala', kategori:'Santai', harga:45000, durasi:'8 mnt', tinggi:'Semua usia', ic:'ferris', seed:'ferris-wheel', desc:'Kincir raksasa dengan kabin tertutup, menawarkan pemandangan pantai dan seluruh area taman dari ketinggian 40 meter. Cocok untuk keluarga.'},
  {id:'kapal-karam', nama:'Kapal Karam', kategori:'Ekstrem', harga:55000, durasi:'10 mnt', tinggi:'130 cm', ic:'ghost', seed:'ghost-house', desc:'Rumah hantu bertema kapal karam, menyusuri lorong gelap di bawah dermaga dengan efek suara dan visual yang mendebarkan.'},
  {id:'kolam-ombak', nama:'Kolam Ombak Buatan', kategori:'Air', harga:50000, durasi:'Bebas', tinggi:'Semua usia', ic:'droplet', seed:'wave-pool', desc:'Kolam ombak buatan dengan gelombang yang dihasilkan setiap 15 menit sekali, memberi sensasi bermain ombak seperti di laut sungguhan.'},
  {id:'flying-fox', nama:'Flying Fox Camar', kategori:'Ekstrem', harga:70000, durasi:'1 mnt', tinggi:'135 cm', ic:'zipline', seed:'zipline-ride', desc:'Meluncur sejauh 250 meter di atas kanopi pantai dengan kecepatan angin laut yang menyegarkan.'},
  {id:'kereta-mini', nama:'Kereta Mini Pesisir', kategori:'Santai', harga:35000, durasi:'12 mnt', tinggi:'Semua usia', ic:'train', seed:'mini-train', desc:'Kereta wisata yang berkeliling seluruh area Samudra Land, melewati semua zona wahana sambil menikmati suasana pantai.'},
  {id:'dunia-air-cilik', nama:'Dunia Air Cilik', kategori:'Anak', harga:40000, durasi:'Bebas', tinggi:'Maks 120 cm', ic:'droplet', seed:'kids-water', desc:'Area bermain air khusus anak dengan kedalaman aman dan berbagai wahana mini yang ramah untuk si kecil.'}
];
const PAY_METHODS = [
  {id:'qris', label:'QRIS', ic:'qr'},
  {id:'transfer', label:'Transfer Bank', ic:'bank'},
  {id:'kartu', label:'Kartu Debit/Kredit', ic:'card'},
  {id:'ewallet', label:'E-Wallet', ic:'wallet'}
];
const ADMIN_FEE = 5000;

/* ================= STATE ================= */
let cart = {};
let selectedPayment = null;
let currentOrder = null;
let activeFilter = 'Semua';
let chatHistory = [];
let currentDetailId = null;
let detailQty = 1;

/* ================= HELPERS ================= */
function formatRupiah(n){ return 'Rp ' + n.toLocaleString('id-ID'); }
function cartCount(){ return Object.values(cart).reduce((a,b)=>a+b,0); }
function cartTotal(){
  return Object.entries(cart).reduce((sum,[id,qty])=>{
    const w = WAHANA.find(x=>x.id===id);
    return sum + (w ? w.harga*qty : 0);
  },0);
}
function bgUrl(w){ return "url('https://picsum.photos/seed/"+w.seed+"/700/460')"; }

/* ================= NAV / ROUTING ================= */
function goToPage(id){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.getElementById('page-'+id).classList.add('active');
  document.querySelectorAll('.nav-link').forEach(l=>l.classList.remove('active'));
  const navEl = document.querySelector('.nav-link[data-nav="'+id+'"]');
  if(navEl) navEl.classList.add('active');
  window.scrollTo({top:0,behavior:'smooth'});
  if(id==='pembayaran') renderPaymentPage();
  updateCartBarVisibility();
}
function handleCartNavClick(){
  if(cartCount()===0){ goToPage('wahana'); } else { goToPage('pembayaran'); }
}
function updateCartBarVisibility(){
  const bar = document.getElementById('cartBar');
  const onWahana = document.getElementById('page-wahana').classList.contains('active');
  const onDetail = document.getElementById('page-detail').classList.contains('active');
  if(cartCount()>0 && (onWahana || onDetail)){ bar.classList.add('show'); } else { bar.classList.remove('show'); }
  document.getElementById('cartBarTotal').textContent = formatRupiah(cartTotal());
  document.getElementById('cartBarCount').textContent = cartCount() + ' tiket dipilih';
  const badge = document.getElementById('cartBadge');
  if(badge){
    if(cartCount()>0){ badge.classList.remove('hidden'); badge.textContent = cartCount(); }
    else { badge.classList.add('hidden'); }
  }
}
function doSearch(){
  const q = document.getElementById('searchInput').value.trim().toLowerCase();
  activeFilter = 'Semua';
  renderFilterChips();
  const list = q ? WAHANA.filter(w=>w.nama.toLowerCase().includes(q)) : WAHANA;
  document.getElementById('wahanaGrid').innerHTML = list.length ? list.map(wahanaCardHTML).join('') : '<p style="grid-column:1/-1;text-align:center;padding:40px 0;">Wahana tidak ditemukan.</p>';
  goToPage('wahana');
}
function setFilterAndGo(cat){
  activeFilter = cat;
  renderFilterChips();
  renderWahanaGrid();
  goToPage('wahana');
}

/* ================= QUICK MENU ================= */
function renderQuickMenu(){
  const items = [
    {icn:'ticket', label:'Pilih Wahana', fn:'goToPage("wahana")'},
    {icn:'cart', label:'Tiket Saya', fn:'goToMyTicket()'},
    {icn:'headset', label:'Hubungi CS', fn:'toggleChat(true)'},
    {icn:'mappin', label:'Info Taman', fn:'openInfoModal()'}
  ];
  document.getElementById('quickMenu').innerHTML = items.map(it=>
    '<button class="quick-item" onclick="'+it.fn+'"><div class="qi-icon">'+icon(it.icn,20,1.8)+'</div><span>'+it.label+'</span></button>'
  ).join('');
}
function goToMyTicket(){
  if(currentOrder){ renderTicketPage(); goToPage('tiket'); }
  else { goToPage('wahana'); }
}
function openInfoModal(){ document.getElementById('infoModalWrap').classList.add('show'); }
function closeInfoModal(){ document.getElementById('infoModalWrap').classList.remove('show'); }

/* ================= RENDER WAHANA CARDS (no qty here, only Beli Tiket) ================= */
function wahanaCardHTML(w){
  return `
  <div class="wahana-card">
    <div class="wahana-media" style="background-image:${bgUrl(w)};">
      <span class="wahana-media-tag">${w.kategori}</span>
      <h3 class="wahana-media-title">${w.nama}</h3>
    </div>
    <div class="wahana-body">
      <div class="wahana-meta">
        <span>${icon('clock',14,2)} ${w.durasi}</span>
        <span>${icon('ruler',14,2)} ${w.tinggi}</span>
      </div>
