/* ================= PAYMENT PAGE ================= */
function renderPayMethods(){
  document.getElementById('payMethods').innerHTML = PAY_METHODS.map(m=>
    `<button class="pay-method ${selectedPayment===m.id?'selected':''}" onclick="selectPayment('${m.id}')">
      ${icon(m.ic,18,1.8)} ${m.label}
    </button>`
